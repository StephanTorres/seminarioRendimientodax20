	measure 'Profit %' = divide([Profit],[Sales Amount])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: 1 Base
		lineageTag: 185ae505-5638-4f33-a7fe-fe19e5c2ce3f

		changedProperty = FormatString

	measure 'Total Sales Currency' = ```
			
			VAR _DateAndCurrency =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            'Internet Sales',
			            'Internet Sales'[OrderDateKey],
			            'Internet Sales'[CurrencyKey]
			        ),
			        "Sales", [Sales Amount],
			        "rate",
			            VAR _ok = 'Internet Sales'[OrderDateKey]
			            VAR _ck = 'Internet Sales'[CurrencyKey]
			            VAR _exc =
			                CALCULATE (
			                    MAX ( _Currency_Rate[AverageRate] ),
			                    TREATAS ( { _ok }, _Currency_Rate[DateKey] ),
			                    TREATAS ( { _ck }, _Currency_Rate[CurrencyKey] )
			                )
			            RETURN
			                _exc
			    )
			RETURN
			    SUMX ( _DateAndCurrency, DIVIDE ( [Sales Amount], [rate] ) )
			
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: 4 Moneda
		lineageTag: 27b3a6fc-74d0-4099-a64a-a1b6e3aa368f

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

	measure 'Total Sales Currency V2' = SUMX('Internet Sales',DIVIDE('Internet Sales'[Sales Amount],'Internet Sales'[_Currency_Rate.AverageRate]))
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: 4 Moneda
		lineageTag: 8b5a422e-6be2-45ee-82cf-f6822934300c

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

	measure 'Total Sales Currency v3' = sum('Internet Sales'[Sales Amount Dolar])
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 4 Moneda
		lineageTag: 64b03ee7-02d5-4843-b52d-31cb41af296c

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

	measure 'Total Sales Currency v4' =
			
			var _moneda=SELECTEDVALUE('Currency  Destination'[CurrencyKey],36) // la moneda y si no dolares
			var _Resultado= SWITCH(_moneda,36,sum('Internet Sales'[Sales Amount Dolar]),100,sum('Internet Sales'[Sales Amount Euro]))
			return _Resultado
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 4 Moneda
		lineageTag: ea59abb0-d732-4414-a337-69061a7ad92f

