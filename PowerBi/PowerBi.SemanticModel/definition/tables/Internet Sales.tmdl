	measure 'Tax Amount (YTD 2)' =
			
			var _fechas=values(_Date_Mxn[DateKeyMxn])
			var _res=
			 CALCULATE([Tax Amount],all('Date'),TREATAS(_fechas,'Internet Sales'[OrderDateKey]) )
			 var _res2=COUNTROWS(values(_Date_Mxn[DateKeyMxn]))
			 var _Res3=CALCULATE([Tax Amount],USERELATIONSHIP('Date'[DateKey],_Date_Mxn[DateKey]))
			return _res
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: YTD
		lineageTag: ea2d4732-4fd9-4b96-be7f-0aee942c93a0

		changedProperty = FormatString

	measure 'Total Cost (YTD 2)' = CALCULATE([Total Cost], USERELATIONSHIP(_Date_Mxn[DateKeyMxn],'Internet Sales'[OrderDateKey]))
