	column 'Producto traducido' = ```
			
			 var _idioma=SELECTEDVALUE(Idiomas[Idioma])
			 var _nombreproductotraducido= SWITCH(_idioma,
			     1, [EnglishProductName],2,[SpanishProductName],[EnglishProductName])
			return _nombreproductotraducido     
			  
			```
		lineageTag: 14098197-65d0-42cc-8676-c6e1b19fe940
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

