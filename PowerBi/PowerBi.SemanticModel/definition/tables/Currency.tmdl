table Currency
	lineageTag: 458a990b-9f64-463c-a35e-d27ebb0c47a2

	measure 'Total acumulado anual' =
			
			var _fechas= VALUEs(_Date_Mxn[DateKeyMxn])
			 var _R= CALCULATE(sum('Internet Sales'[SalesAmount]),
			   _fechas)
			return CALCULATE([Sales Amount] ,_fechas)
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: faa28b0f-c578-4696-9ff6-d30a715496e2

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

	measure 'sales amount deliver' = CALCULATE([Sales Amount],USERELATIONSHIP('Date'[DateKey],'Internet Sales'[DueDateKey]))
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: a9fe2ed0-0fe6-4ce3-b680-edc7837381d9

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

