# Power BI: la caché de datos del PBIP (cientos de MB) no se versiona
powerbi/**/.pbi/cache.abf
powerbi/**/.pbi/localSettings.json
powerbi/**/.pbi/unappliedChanges.json
# Copia «después» del modelo (demo antes/después del bloque 1)
powerbi-*/**/.pbi/cache.abf
powerbi-*/**/.pbi/localSettings.json
powerbi-*/**/.pbi/unappliedChanges.json
*.pbix

# Puente DAX: binarios generados y ajustes locales del depurador
puente-dax/instalar/*.exe
puente-dax/instalar/*.dll
puente-dax/**/launchSettings.json
puente-dax/bin-local/
