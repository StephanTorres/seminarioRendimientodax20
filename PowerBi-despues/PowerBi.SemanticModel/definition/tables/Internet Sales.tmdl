		changedProperty = FormatString

	measure 'Total Sales Currency' = ```
			
			VAR _DateAndCurrency =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            'Internet Sales',
			            'Internet Sales'[OrderDateKey],
			            'Internet Sales'[CurrencyKey]
			        ),
			        "Sales", [Sales Amount],
			        "rate",
			            VAR _ok = 'Internet Sales'[OrderDateKey]
			            VAR _ck = 'Internet Sales'[CurrencyKey]
			            VAR _exc =
			                CALCULATE (
			                    MAX ( _Currency_Rate[AverageRate] ),
			                    TREATAS ( { _ok }, _Currency_Rate[DateKey] ),
			                    TREATAS ( { _ck }, _Currency_Rate[CurrencyKey] )
			                )
			            RETURN
			                _exc
			    )
			RETURN
			    SUMX ( _DateAndCurrency, DIVIDE ( [Sales Amount], [rate] ) )
			
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: 4 Moneda
		lineageTag: 27b3a6fc-74d0-4099-a64a-a1b6e3aa368f

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

	measure 'Total Sales Currency V2' = [Total Sales Currency]
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: 4 Moneda
		lineageTag: 8b5a422e-6be2-45ee-82cf-f6822934300c

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

	measure 'Total Sales Currency v3' = [Total Sales Currency Dolar]
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 4 Moneda
		lineageTag: 64b03ee7-02d5-4843-b52d-31cb41af296c

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

	measure 'Total Sales Currency v4' =
			VAR _moneda = SELECTEDVALUE ( 'Currency  Destination'[CurrencyKey], 36 )
			RETURN
			    SWITCH ( _moneda, 36, [Total Sales Currency Dolar], 100, [Total Sales Currency Euro] )
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 4 Moneda
		lineageTag: ea59abb0-d732-4414-a337-69061a7ad92f

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

	measure 'Total Sales Currency Dolar' =
			VAR _FechaYMoneda =
			    ADDCOLUMNS (
			        SUMMARIZE ( 'Internet Sales', 'Internet Sales'[OrderDateKey], 'Internet Sales'[CurrencyKey] ),
			        "_importe", [Sales Amount],
			        "_tasa",
			            VAR _fecha = 'Internet Sales'[OrderDateKey]
			            VAR _moneda = 'Internet Sales'[CurrencyKey]
			            RETURN
			                CALCULATE (
			                    MAX ( _Currency_Rate[AverageRate] ),
			                    TREATAS ( { _fecha }, _Currency_Rate[DateKey] ),
			                    TREATAS ( { _moneda }, _Currency_Rate[CurrencyKey] )
			                )
			    )
			RETURN
			    SUMX ( _FechaYMoneda, DIVIDE ( [_importe], [_tasa] ) )
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 4 Moneda
		lineageTag: b3cd9fa4-b279-4c24-9f1a-e0657a1684eb

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

	measure 'Total Sales Currency Euro' =
			VAR _FechaYMoneda =
			    ADDCOLUMNS (
			        SUMMARIZE ( 'Internet Sales', 'Internet Sales'[OrderDateKey], 'Internet Sales'[CurrencyKey] ),
			        "_importe", [Sales Amount],
			        "_tasa",
			            VAR _fecha = 'Internet Sales'[OrderDateKey]
			            VAR _moneda = 'Internet Sales'[CurrencyKey]
			            RETURN
			                CALCULATE (
			                    MAX ( _Currency_Rate[AverageRate] ),
			                    TREATAS ( { _fecha }, _Currency_Rate[DateKey] ),
			                    TREATAS ( { _moneda }, _Currency_Rate[CurrencyKey] )
			                ),
			        "_tasaEuro",
			            VAR _fecha = 'Internet Sales'[OrderDateKey]
			            RETURN
			                CALCULATE (
			                    MAX ( _Currency_Rate[AverageRate] ),
			                    TREATAS ( { _fecha }, _Currency_Rate[DateKey] ),
			                    TREATAS ( { 36 }, _Currency_Rate[CurrencyKey] )
			                )
			    )
			RETURN
			    SUMX ( _FechaYMoneda, DIVIDE ( [_importe], [_tasa] ) * [_tasaEuro] )
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 4 Moneda
		lineageTag: db063e22-2668-4b50-a51f-0e94708ddd66

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

