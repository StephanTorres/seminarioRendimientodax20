	/// Importe de ventas. Base de las medidas de la demo de año anterior.
	measure Ventas = [Sales Amount]
		formatString: #,0
		displayFolder: 7 Demo año anterior
		lineageTag: 9624a5ce-5496-4a0e-9087-d742a27c21a0

	/// Demo AA 1/5: SAMEPERIODLASTYEAR clásico.
	measure 'Ventas AA · SPLY' = CALCULATE ( [Ventas], SAMEPERIODLASTYEAR ( 'Fecha'[Date] ) )
		formatString: #,0
		displayFolder: 7 Demo año anterior
		lineageTag: ecf0dda9-9a0e-43b6-bb25-448d517bf41c

	/// Demo AA 2/5: restar 1 al año, respetando mes. Incluye el 29-feb a nivel de mes.
	measure 'Ventas AA · Offset mes' =
			VAR _anio = SELECTEDVALUE ( 'Fecha'[Year] )
			RETURN
			    CALCULATE ( [Ventas], REMOVEFILTERS ( 'Fecha' ), 'Fecha'[Year] = _anio - 1, VALUES ( 'Fecha'[Month] ) )
		formatString: #,0
		displayFolder: 7 Demo año anterior
		lineageTag: 1339a8ca-3da1-4667-b210-44c503a38a87

	/// Demo AA 2/5: restar 1 al año, respetando mes y día. El 29-feb no tiene pareja.
	measure 'Ventas AA · Offset día' =
			VAR _anio = SELECTEDVALUE ( 'Fecha'[Year] )
			RETURN
			    CALCULATE (
			        [Ventas], REMOVEFILTERS ( 'Fecha' ),
			        'Fecha'[Year] = _anio - 1, VALUES ( 'Fecha'[Month] ), VALUES ( 'Fecha'[Day] )
			    )
		formatString: #,0
		displayFolder: 7 Demo año anterior
		lineageTag: 93266d7d-3d56-4287-b79f-4d139d768a1f

	/// Demo AA 3/5: inteligencia de tiempo basada en calendarios (preview).
	measure 'Ventas AA · Calendario' = CALCULATE ( [Ventas], SAMEPERIODLASTYEAR ( 'Gregoriano' ) )
		formatString: #,0
		displayFolder: 7 Demo año anterior
		lineageTag: d9125a9d-5df3-4465-86e3-49c412404c26

	/// Demo AA 4/5: columna desplazada en los hechos (FechaAA) con relación inactiva.
	measure 'Ventas AA · Columna' = CALCULATE ( [Ventas], USERELATIONSHIP ( 'Fecha'[Date], 'Internet Sales'[FechaAA] ) )
		formatString: #,0
		displayFolder: 7 Demo año anterior
		lineageTag: 14cf3995-c373-4cc8-baa2-86aeee04a6da

	/// AA del periodo menos la suma de los AA día a día. Distinto de 0 si el método pierde el 29-feb.
	measure 'Cuadre 29-feb · SPLY' = [Ventas AA · SPLY] - SUMX ( VALUES ( 'Fecha'[Date] ), [Ventas AA · SPLY] )
		formatString: #,0
		displayFolder: 7 Demo año anterior\Cuadre
		lineageTag: 045e7e84-2a83-47a0-b86d-04ff999ca09c

	/// AA mes menos la suma de los AA día del offset.
	measure 'Cuadre 29-feb · Offset' = [Ventas AA · Offset mes] - SUMX ( VALUES ( 'Fecha'[Date] ), [Ventas AA · Offset día] )
		formatString: #,0
		displayFolder: 7 Demo año anterior\Cuadre
		lineageTag: fae515ca-de9e-477a-a2d5-dec137d5a87a

	/// AA del periodo menos la suma de los AA día a día con calendarios.
	measure 'Cuadre 29-feb · Calendario' = [Ventas AA · Calendario] - SUMX ( VALUES ( 'Fecha'[Date] ), [Ventas AA · Calendario] )
		formatString: #,0
		displayFolder: 7 Demo año anterior\Cuadre
		lineageTag: 53396ba3-e040-44fb-8374-29a90a5635be

	/// AA del periodo menos la suma de los AA día a día con la columna desplazada.
	measure 'Cuadre 29-feb · Columna' = [Ventas AA · Columna] - SUMX ( VALUES ( 'Fecha'[Date] ), [Ventas AA · Columna] )
		formatString: #,0
		displayFolder: 7 Demo año anterior\Cuadre
		lineageTag: b70f9302-db1f-4dc6-8fba-2ea34b2a971b

