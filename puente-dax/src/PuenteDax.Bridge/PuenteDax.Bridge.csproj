<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>PuenteDax</AssemblyName>
    <RootNamespace>PuenteDax.Bridge</RootNamespace>
    <!-- Ejecutable autocontenido de un solo fichero: dotnet publish -c Release -r win-x64 -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AnalysisServices" Version="19.114.12" />
    <PackageReference Include="Microsoft.AnalysisServices.AdomdClient" Version="19.114.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PuenteDax.Core\PuenteDax.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- El widget y la página de demo viajan dentro del .exe -->
    <EmbeddedResource Include="..\..\web\*.*" LogicalName="web/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
